//{ * 선형변환식 만들기
//
//	*좌표계는 1번 카메라 기준으로 계산함
//	*도면 Align 마크 좌표
//	마크 1: X1, Y1
//	마크 2: X2, Y2
//	
//	*카메라로 실측한 Align 좌표
//	마크 1: CX1, CY1
//	마크 2: CX2, CY2
//
//	*스케일 : S
//
//	*옵셋 : OFFSET
//
//-------------------------------------------------------------------
//	 
//	*도면 좌표 행렬 4x4
//	A = [X1, -Y1,	1,	0]
//		[Y1,  X1,	0,	1]
//		[X2, -Y2,	1,	0]
//		[Y2,  X2,	0,	1]
//	 
//
//	*카메라 좌표 행렬 4x1
//	B = [ CX1, CY1, CX2, CY2]
//	   
//	* 닮음 변환 행렬
//	C = A.Inv() * B;   // (A의 역행렬 * B)
//
//	* 선형 변환 3x3
//	D = [C(0, 0), -C(1, 0), C(2, 0)]
//		[C(1, 0),  C(0, 0), C(3, 0)]
//		[	   0,		 0,		  1]
//
//	결과는 => D
//}
//
//
//{ * 선형 변환 행렬 D로 결과 좌표 구하기
//
//	도면 상의 가공 라인 좌표 SX1, SY1, SX2, SY2
//	결과좌표 RX1, RY1, RX2, RY2
//	 
//	도면 좌표 행렬 3x1
//	S1 = [SX1, SY1, 1]
//	S2 = [SX2, SY2, 1]
//	
//	R1 = D * S1;
//	R2 = D * S2;
//	
//	* RX1 = R1(0, 0) * S + OFFSET.x;
//	* RY1 = R1(1, 0) * S + OFFSET.y;
//	* RX2 = R2(0, 0) * S + OFFSET.x;
//	* RY2 = R2(1, 0) * S + OFFSET.y;
//}